# ---------------------------------------------------------------------------
# Copy to `.env` before running `docker compose up`.
# Defaults are wired for the local compose stack and work out of the box.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
POSTGRES_USER=alma
POSTGRES_PASSWORD=alma
POSTGRES_DB=alma
DATABASE_URL=postgresql+asyncpg://alma:alma@postgres:5432/alma
# Host-side port for psql/GUI access. Change if 5433 is taken locally;
# this does not affect container-to-container connections.
POSTGRES_HOST_PORT=5433

# --- Auth ------------------------------------------------------------------
# Generate a real one with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-0123456789abcdef0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Seed attorney account (created by `make seed`) ------------------------
SEED_ADMIN_EMAIL=attorney@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Alma Attorney

# --- Resume storage --------------------------------------------------------
# STORAGE_BACKEND: "s3" (MinIO in compose) or "local" (disk)
STORAGE_BACKEND=s3
S3_BUCKET=alma-resumes
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
# Endpoint baked into presigned URLs, must be reachable from the browser.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
LOCAL_STORAGE_DIR=/var/lib/alma/resumes

MAX_RESUME_SIZE_BYTES=5242880

# --- Email -----------------------------------------------------------------
# EMAIL_BACKEND: "smtp" (MailHog in compose) or "console" (structured log)
EMAIL_BACKEND=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Alma
ATTORNEY_NOTIFICATION_EMAIL=attorney@example.com

# --- URLs ------------------------------------------------------------------
# Used to build the "view lead" deep link inside attorney notification emails.
INTERNAL_APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Frontend --------------------------------------------------------------
# Server-side (container to container)
API_BASE_URL=http://backend:8000
# Client-side (browser to host)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
SESSION_COOKIE_NAME=alma_session
